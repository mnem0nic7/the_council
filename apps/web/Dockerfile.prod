FROM node:20-slim AS deps

WORKDIR /app

COPY package.json package-lock.json /app/
COPY tsconfig.base.json /app/tsconfig.base.json
COPY packages/contracts /app/packages/contracts
COPY apps/web /app/apps/web

RUN npm ci

FROM deps AS build

ARG NEXT_PUBLIC_RUNTIME_URL=/api/v1
ARG NEXT_PUBLIC_WS_URL=auto

ENV NEXT_PUBLIC_RUNTIME_URL=${NEXT_PUBLIC_RUNTIME_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}

RUN npm run build --workspace @the-council/contracts && \
    npm run build --workspace @the-council/web

FROM node:20-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=build /app/apps/web/.next/standalone /app/
COPY --from=build /app/apps/web/.next/static /app/apps/web/.next/static
COPY --from=build /app/apps/web/public /app/apps/web/public

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
